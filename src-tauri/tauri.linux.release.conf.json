{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "npm run build && npm run package:backend:linux"
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "externalBin": [
      "binaries/frontier-backend"
    ],
    "shortDescription": "A project-first desktop AI workspace",
    "category": "DeveloperTool",
    "createUpdaterArtifacts": true
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "npm run build && npm run package:backend"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/frontier-backend"],
    "shortDescription": "A project-first desktop AI workspace",
    "category": "DeveloperTool",
    "windows": {
      "webviewInstallMode": {"type": "downloadBootstrapper", "silent": true},
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "startMenuFolder": "Frontier",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
